# How to run:
#   crabber test-11.crabir -d int --print-invariants
#
# Deeply nested loops: a fixpoint stress test. It has no EXPECT_EQ, so nothing
# is checked. Not registered as a test in CMakeLists.txt.

procedure("nested-loops-2")
start:
 i := 0
 goto l1

l1:
 if (i < 11) goto l1_body else goto l1_exit

l1_body:
 j := 0
 goto l2

l1_exit:


l2:
if (j < 11) goto l2_body else goto l2_exit

l2_body:
 k := 0
 goto l3

l2_exit:
 i := i + 1
 goto l1

l3:
 if (k < 16) goto l3_body else goto l3_exit

l3_body:
 l := 0
 goto l4

l3_exit:
 j := j + 1
 goto l2


l4:
 if (l < 16) goto l4_body else goto l4_exit

l4_body:
 m := 0
 goto l5

l4_exit:
 k := k + 1
 goto l3

l5:
 if (m < 3) goto l5_body else goto l5_exit

l5_body:
 n := 0
 goto l6

l5_exit:
 l := l + 1
 goto l4

l6:
 if (n < 3) goto l6_body else goto l6_exit

l6_body:
 n := n + 1
 goto l6

l6_exit:
 m := m + 1
 goto l5 
