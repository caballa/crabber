cfg("non-unit-coefficients")
start:
   havoc(N)
   assume(N > 0)
   i := 0
   x := 0
   y := 0     
   goto loop_header
loop_header:
   if (i < N) goto loop_body else goto exit
loop_body:   
   i := i + 1
   x := x + 4
   y := y + 8
   goto loop_header
exit:
   EXPECT_EQ(true, assert(x == 4*N))
   EXPECT_EQ(true, assert(y == 8*N))
