# this is a comment
# newline is used to delimit a new instruction, new block or new cfg
# A cfg must have a name
# Blocks are denoted as a string name followed by ":".
# The entry block of a cfg must be called "start"
# Integers are mathematical integers and need no type annotation

cfg("foo")
  start: 
   x := 0
   goto loop
  loop: 
   x := x + 1
   if (x <= 9) goto loop else goto out
  out: 
   EXPECT_EQ(false, assert(x != 10))

cfg("bar")
  start: 
   y := 0
   goto loop
  loop:  
   y := y + 1
   if (y <=  9) goto loop else goto out
  out: 
   EXPECT_EQ(true, assert(y == 10))
