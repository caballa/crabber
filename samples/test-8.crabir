# How to run:
#   crabber test-8.crabir -d zones

# Arrays. The element size of an access is optional and defaults to 1, under
# which distinct indices are independent and the array behaves as a plain map
# from addresses to values. See test-13 for an access with a wider extent.

cfg("arrays")
start:
   x_addr := 1024
   x := 0  
   array_store(Stack, x_addr, x)
   goto loop
loop:
   x := array_load(Stack, x_addr)
   x := x + 1
   array_store(Stack, x_addr, x)
   if (x <= 9) goto loop else goto exit
exit:
   x := array_load(Stack, x_addr)
   EXPECT_EQ(true, assert(x == 10))
