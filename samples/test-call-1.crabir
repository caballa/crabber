# How to run:
#   crabber test-call-1.crabir -d zones
#

# Function calls: a procedure with one input and one output parameter.
#
# A procedure parameter list is written after the procedure name as a
# comma-separated sequence of "direction name:sort" where direction is "in" or
# "out".
# Function interfaces are always fully typed, at the declaration and at the
# call site, even though ":int" is optional everywhere else.
#
# A call is written with the (optional) outputs on the left-hand side and the
# inputs as arguments:
#     out:sort := call callee(in:sort)
# A single output may be written with or without parentheses.

# inc(a) returns a + 1
procedure("inc", in a:int, out b:int)
  start:
   b := a + 1
   exit

procedure("main")
  start:
   x := 5
   y:int := call inc(x:int)
   EXPECT_EQ(true, assert(y == 6))
