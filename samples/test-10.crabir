# How to run:
#   crabber test-10.crabir -d int-terms

procedure("terms")
start:
   havoc(x)
   havoc(y)
   
   assume(x >= 0)
   assume(x <= 10)
   assume(y >= -10)
   assume(y <= 10)   
   z := x * y
   if (y < 0) goto b1 else goto b2
b1:
   z := - z
   goto b2
b2:   
   EXPECT_EQ(true, assert(z >= 0))
   EXPECT_EQ(true, assert(z <= 100))   
