# How to run:
#   crabber test-call-2.crabir -d zones
#

# Function calls: multiple inputs and multiple outputs.
#
# When a call has more than one output, the outputs are written as a
# parenthesized, comma-separated list. Parameters and arguments may mix sorts
# (here int and bool).

# swap(x, z) returns (z, x)
cfg("swap", in x:int, in z:bool, out y:int, out w:bool)
  start:
   y := x
   w:bool := z
   exit

cfg("main")
  start:
   a := 1
   c := true
   (p:int, q:bool) := call swap(a:int, c:bool)
   EXPECT_EQ(true, assert(p == 1))
   EXPECT_EQ(true, assert(q))
