# How to run:
#   crabber test-call-4.crabir -d zones
#

# Function calls: the same callee is invoked from several call sites and the
# callee itself has non-trivial control flow (a loop).

# clamp(a) returns min(a, 10) for a non-negative a
cfg("clamp", in a:int, out b:int)
  start:
   b := a
   goto loop
  loop:
   if (b <= 10) goto out else goto dec
  dec:
   b := b - 1
   goto loop
  out:
   exit

cfg("main")
  start:
   x := 3
   u:int := call clamp(x:int)
   EXPECT_EQ(true, assert(u <= 10))
   y := 100
   v:int := call clamp(y:int)
   EXPECT_EQ(true, assert(v <= 10))
