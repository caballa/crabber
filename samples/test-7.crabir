cfg("loop-partitioning")
  start: 
    x := 0
    value_partition_start(x)
    goto b1
  b1: 
    x := x + 1
    if (x == 5) goto b2 else goto b3
  b2:
    y := 0
    goto b3
  b3:
    if (x > 5) goto b4 else goto b5
  b4:
    y := y + 1
    goto b5
  b5:
    if (x <= 9) goto b1 else goto exit
  exit:
    EXPECT_EQ(true, assert(x == 10))
    EXPECT_EQ(true, assert(y == 5))
    value_partition_end(x)
