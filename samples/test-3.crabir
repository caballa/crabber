# How to run:
#   crabber test-3.crabir -d int

cfg("nested-loops")
start:
  i := 0
  goto b0
b0:
  goto b1
b1: # outer loop entry 
  i := i + 1
  j := 0
  goto b2 
b2: # inner loop entry
  if (j <= 9) goto b3 else goto b4
b3: 
  EXPECT_EQ(true, assert(i >= 0))
  EXPECT_EQ(true, assert(i <= 10))
  j := j + 1
  goto b2
b4:
  assume(j >= 10)
  if (i>=10) goto b5 else goto b6
b5:
  i := 0
  goto b6
b6:
  goto b1
