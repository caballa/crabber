# How to run:
#   crabber test-2.crabir -d int --print-invariants
#
# A parsing showcase: it has no EXPECT_EQ, so nothing is checked. Not
# registered as a test in CMakeLists.txt.

# Parsing example: irregular but legal whitespace everywhere.
#
# The long runs of spaces below are deliberate. The grammar is
# whitespace-insensitive, so every token pattern carries its own "\s*"; that
# makes patterns like ANY CMPOP ANY expand to adjacent "\s*" runs around lazy
# wildcards, and on a line that fails to match std::regex used to explore
# every way of splitting a run of spaces between them. A dozen spaces in an
# assignment was enough to exceed libc++'s backtracking limit and abort. The
# parser now canonicalizes whitespace before matching, and these lines keep
# that fixed.

    procedure("parsing-example")
start : 
    havoc  ( y )
	havoc	(	z	)
    x                     :=                     0
   goto loop
  loop   : 
   x := y +    2 *   z + 6 - z                              
      if ( x <=  9) goto loop else goto out
 out : 
    assert ( 2*x -6 !=    y + 10 )
