# How to run:
#   crabber test-2.crabir -d int --print-invariants
#
# A parsing showcase: it has no EXPECT_EQ, so nothing is checked. Not
# registered as a test in CMakeLists.txt.

# Parsing example

    cfg("parsing-example")
start : 
    havoc  (y : i64 )
   havoc ( z :i64)
    x:i64 := 0
   goto loop
  loop   : 
   x:i64 := y +    2 *   z + 6 - z 
      if ( x <=  9):i64 goto loop else goto out
 out : 
    assert ( 2*x -6 !=    y + 10 ):i64
