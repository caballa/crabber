# How to run:
#   crabber test-call-3.crabir -d zones
#

# Function calls: a call with no outputs (void call) and an input-only
# procedure.
#
# When a callee has no output parameters, the call is written without a
# left-hand side:
#     call callee(in:sort)

# check(p) asserts that its input is non-negative
procedure("check", in p:int)
  start:
   EXPECT_EQ(true, assert(p >= 0))
   exit

procedure("main")
  start:
   x := 42
   call check(x:int)
   exit
